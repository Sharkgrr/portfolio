{
  "name": "raphaela-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,agent \"npm:dev:web\" \"npm:dev:agent\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:agent": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.38",
    "@mastra/core": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
